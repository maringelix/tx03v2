# Copy to terraform.tfvars (git-ignored) for local runs. CI uses TF_VAR_* repository variables
# instead (docs/RUNBOOK.md). Placeholder values only.
project_id = "tx03v2-lab-example"
region     = "us-central1"

# Your GitHub user (the owner of your fork). The workflows pass github.repository_owner instead.
github_owner = "your-github-user"

# Bootstrap output deploy_service_account (e-mail of dx03v2-gha-deploy).
deploy_service_account = "dx03v2-gha-deploy@tx03v2-lab-example.iam.gserviceaccount.com"

# Extra deployers (optional): they get the roles of dx03v2-gha-deploy and, through
# platform/install.sh, a subject in the dx03v2-deployers RoleBinding.
app_deployer_members = ["user:you@example.com"]

# Lab-friendly defaults (change only if you know the cost impact, see docs/CUSTOS.md):
# enable_waf        = true
# dns_zone_name      = "example.com"       # optional, delegate its name servers at the registrar
# app_domain_name    = "lab.example.com"   # required with dns_zone_name for HTTPS
# enable_managed_mesh = true                # required by platform --profile full
# db_tier           = "db-g1-small"
# db_profile        = "core"             # opt-in: ha or dr (second region has significant cost)
# ha_db_tier        = "db-custom-1-3840" # dedicated CPU for HA/DR
# db_backup_count   = 7                  # null uses 1 in core and 7 in ha/dr
# dr_region         = "us-east1"         # only for db_profile=dr; different from region
# nodes_subnet_cidr = "10.30.0.0/20"
# pods_cidr         = "10.32.0.0/16"
# services_cidr     = "10.33.0.0/20"
# control_plane_cidr = "172.31.255.240/28"   # private /28 of the GKE control plane; must overlap nothing above
