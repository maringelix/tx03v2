# Copy to terraform.tfvars (git-ignored). Placeholder values only.

# Required: the dedicated project (created by you, billing linked) and its billing account
# (gcloud billing projects describe <project> --format='value(billingAccountName)').
project_id      = "tx03v2-lab-example"
billing_account = "000000-000000-000000"

region = "us-central1"

# Required: your GitHub user, the owner of your forks of tx03v2 and dx03v2 (the service accounts
# trust only their workflows). The placeholder is refused.
github_owner = "your-github-user"

# Required: the numeric GitHub IDs that the OIDC subject carries (scripts/repo-guardrails.sh prints
# them for a repository):
#   gh api users/<owner> --jq .id          -> github_owner_id
#   gh api repos/<owner>/tx03v2 --jq .id   -> tx03v2_repository_id
#   gh api repos/<owner>/dx03v2 --jq .id   -> dx03v2_repository_id
github_owner_id      = "1000000"
tx03v2_repository_id = "2000000"
dx03v2_repository_id = "3000000"

# Monthly budget in the currency of the billing account, counted before credits (a free trial's
# credits would hide the spend). budget_alert_emails is required: name at least one address you read
# (the placeholder is refused); the billing account administrators get the alerts as well.
budget_amount       = 10
budget_alert_emails = ["you@example.com"]

# Only if a real apply fails with PERMISSION_DENIED for a permission that none of the roles of
# tx03v2-gha-apply has (docs/RUNBOOK.md, section 12). Empty by default.
# apply_extra_project_roles = []
