# Copy to terraform.tfvars (git-ignored). Placeholder values only.

# Required: the dedicated project (created by you, billing linked) and its billing account
# (gcloud billing projects describe <project> --format='value(billingAccountName)').
project_id      = "tx03v2-lab-example"
billing_account = "000000-000000-000000"

region = "us-central1"

# Required: your GitHub user, the owner of your forks of tx03v2 and dx03v2 (the service accounts
# trust only their workflows). The placeholder is refused.
github_owner = "your-github-user"

# Monthly budget in the currency of the billing account. The billing account administrators always
# get the alerts; add e-mails for extra notification channels, or leave the list empty (the
# placeholder is refused).
budget_amount       = 10
budget_alert_emails = ["you@example.com"]
