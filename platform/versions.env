# Versions installed by platform/install.sh (verified 2026-10-11). Update procedure:
# docs/SUSTENTACAO.md. Values: KEY=VALUE, no quotes (read without executing the file).
#
# External Secrets Operator, OCI chart on GHCR (oci://ghcr.io/external-secrets/charts/external-secrets),
# app v2.12.0, CRDs served as external-secrets.io/v1 (same release and image digest as tx01v2 and
# tx02v2). install.sh and the harness pull <version>@sha256:<ESO_CHART_DIGEST> (helm refuses a
# manifest with another digest) and then refuse an archive whose SHA256 differs from
# ESO_CHART_SHA256. The GKE Gateway controller is managed by Google: nothing else to install.
ESO_CHART_OCI=oci://ghcr.io/external-secrets/charts/external-secrets
ESO_CHART_VERSION=2.12.0
ESO_CHART_DIGEST=4a421e51d49160291b4765a42c6326355ee830cb1082c83ff2f62ebe0818265b
ESO_CHART_SHA256=4b584136b7311c0af8c8719d377cc5b1a7ef12c2de18f1fdb30614eab75bdeb3
